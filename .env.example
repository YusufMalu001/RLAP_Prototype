# Neon PostgreSQL
DATABASE_URL="postgresql://user:password@region.neon.tech/database?sslmode=require&channel_binding=require"

# apps/api
API_PORT=4000
COOKIE_SECRET="dev-insecure-cookie-secret"

# Optional — free-tier Google Gemini API key for LLM-backed lab-test recommendations
# (get one free at https://aistudio.google.com/apikey). Without it, the app falls back to a
# deterministic rule-based recommender automatically — no functionality is lost, just less
# adaptive suggestions.
GEMINI_API_KEY=""

# apps/web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# apps/admin
NEXT_PUBLIC_API_URL_ADMIN="http://localhost:4000"

# Google OAuth for Stitch Design Integration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# Stitch Project ID (from your project URL)
STITCH_PROJECT_ID="661045816018978058"
